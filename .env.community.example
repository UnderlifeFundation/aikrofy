# ==============================================================================
# AIKROFY COMMUNITY EDITION (OPEN-CORE) - ENVIRONMENT CONFIGURATION
# Proyecto promovido por FUNDACIÓN UNDERLIFE | Ingeniería por WEBLIFETECH
# ==============================================================================

# Entorno
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=aikrofy-community-secret-key-change-in-production

# Base de datos (SQLite por defecto para fácil despliegue local o MariaDB)
DATABASE_URL=sqlite:///./aikrofy_community.db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/aikrofy_db

# Puerto Backend FastAPI
PORT=5010
HOST=0.0.0.0

# LLM Providers (configura al menos una clave API)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# WhatsApp Local Connector (Baileys en puerto 3011)
WHATSAPP_SERVER_URL=http://localhost:3011
WHATSAPP_SECRET_TOKEN=community-local-token

# Frontend URL
FRONTEND_URL=http://localhost:3000
