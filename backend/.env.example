# Environment Variables Template
# Copy this file to .env and fill in your credentials

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database Configuration
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/aikrofy
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=aikrofy

# Pinecone (Vector Database for RAG)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=aikrofy-rag

# LLM Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Twilio (WhatsApp, Voice, SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Google APIs (Calendar, Sheets)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5010/api/auth/google/callback

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# ElevenLabs (Voice Synthesis)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Application Settings
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_VOICE_PROVIDER=elevenlabs

# LiveKit (Real-time Voice/Video)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Internal API Security
# Token to secure internal API endpoints (voice agent communication)
# Leave empty to disable token verification (development mode)
INTERNAL_API_TOKEN=your-secure-random-token-here

# Voice Agent API URL
# URL for the FastAPI backend from the voice agent's perspective
ONEPUNCH_API_URL=http://localhost:5010

# HubSpot OAuth Integration
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
HUBSPOT_REDIRECT_URI=http://localhost:5010/api/auth/hubspot/callback

# WhatsApp Baileys API (Node.js microservice)
# URL for the WhatsApp API service
WHATSAPP_API_URL=http://localhost:3011

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6380/0

# --- Paddle Billing ---
PADDLE_API_KEY=your_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret_here
PADDLE_ENVIRONMENT=sandbox

# --- LangSmith Monitoring ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="aikrofy-production"

# --- Media WebLifeTech Central Microservices (FFmpeg, Whisper STT, Edge-TTS) ---
MEDIA_MICRO_STT_URL=https://media.weblifetech.com/api/micro/audio/transcribe
MEDIA_TTS_URL=https://media.weblifetech.com/api/tts/speak
MEDIA_STT_URL=https://media.weblifetech.com/api/external/transcribe
EXTERNAL_API_KEY=your_external_api_key_if_any
